www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /uploads/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		root * /srv/frontend
		header Cache-Control "no-cache"
		file_server
	}
}
